table dim_date
	lineageTag: 29bb043f-f392-50fb-9571-1c1913363ff3
	dataCategory: Time

	column date_day
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 3f959900-5095-577f-9c7d-90ad16b91dea
		summarizeBy: none
		sourceColumn: date_day

		annotation UnderlyingDateTimeDataType = Date

	column week_start
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: d0ee66e4-5ebf-5372-a54f-1b08ef091d25
		summarizeBy: none
		sourceColumn: week_start

		annotation UnderlyingDateTimeDataType = Date

	column month_start
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 7c5ecad0-be09-5194-a862-0bf5f54417df
		summarizeBy: none
		sourceColumn: month_start

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		formatString: #,0
		lineageTag: d5d8ef7c-d96b-5bab-a95e-fc6ee6f11a06
		summarizeBy: none
		sourceColumn: year

	column month
		dataType: int64
		formatString: #,0
		lineageTag: 8eddc8c7-62f0-5843-9896-256177bace18
		summarizeBy: none
		sourceColumn: month

	column day_of_month
		dataType: int64
		formatString: #,0
		lineageTag: f4c4b5fa-131b-53cf-91e6-9991e2c6ca71
		summarizeBy: none
		sourceColumn: day_of_month

	column is_complete_month = dim_date[month_start] <= EOMONTH(MAX(rpt_sales_overview[invoice_date]), -2) + 1 && dim_date[month_start] >= MIN(rpt_sales_overview[invoice_month])
		dataType: boolean
		lineageTag: f2ad9b91-b169-5e67-8c49-20cfd756f880
		summarizeBy: none

	partition dim_date = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\dim_date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"date_day", type date}, {"week_start", type date}, {"month_start", type date}, {"year", Int64.Type}, {"month", Int64.Type}, {"day_of_month", Int64.Type}}, "en-US")
				in
					Typed

