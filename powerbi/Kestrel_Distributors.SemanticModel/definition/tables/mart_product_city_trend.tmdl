table mart_product_city_trend
	lineageTag: 58dcdb78-2263-5752-aa86-989a58da06d9

	measure 'Seasonality Index' = AVERAGE(mart_product_city_trend[seasonality_adjusted_index])
		formatString: 0.00
		lineageTag: 19c60d17-f4b6-5dbc-967d-d4a6fd667ccd

	measure 'Slowing Products' = CALCULATE(COUNTROWS(mart_product_city_trend), mart_product_city_trend[lost_sales_per_month] >= 200000)
		formatString: #,0
		lineageTag: 5348356a-97a3-5bcf-9142-035df645964a

	measure 'Lost Sales per Month' = CALCULATE(SUM(mart_product_city_trend[lost_sales_per_month]), mart_product_city_trend[lost_sales_per_month] >= 200000)
		formatString: #,0
		lineageTag: dd79813e-bcfc-5577-b736-8208d1758cfe

	measure 'Lost Sales Text' = VAR v = [Lost Sales per Month] RETURN IF(ISBLANK(v), BLANK(), IF(ABS(v) >= 10000000, "Rs " & FORMAT(v / 10000000, "0.0") & " Cr", "Rs " & FORMAT(v / 100000, "0.0") & " lakh"))
		lineageTag: ba010319-2b27-54ae-b697-67957104751e

	measure 'Slowdown Detail' = VAR t = TOPN(1, mart_product_city_trend, mart_product_city_trend[lost_sales_per_month], DESC) RETURN [Slowing Products] & " slowdowns · biggest: " & MAXX(t, mart_product_city_trend[product_name]) & " (" & MAXX(t, mart_product_city_trend[city]) & ")"
		lineageTag: b64f742a-7210-536a-8917-e45075fa5f14

