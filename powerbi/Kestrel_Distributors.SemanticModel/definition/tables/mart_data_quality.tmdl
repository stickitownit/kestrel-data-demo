table mart_data_quality
	lineageTag: 308ed02c-4762-5a07-a25c-ea1c3e8663e0

	measure 'Issues Found' = COUNTROWS(mart_data_quality)
		formatString: #,0
		lineageTag: 07d24aff-5748-540f-9ef0-148e01bf3cff

	column sort_order
		dataType: int64
		formatString: #,0
		lineageTag: 17025f45-f292-5388-a9b1-ec26291ce004
		summarizeBy: none
		sourceColumn: sort_order

	column issue
		dataType: string
		lineageTag: 12fa7a8f-2a33-5327-8ce1-f053ebf58585
		summarizeBy: none
		sourceColumn: issue

	column source_system
		dataType: string
		lineageTag: 500818c7-e9b5-5a83-8182-9d5e99f4c71f
		summarizeBy: none
		sourceColumn: source_system

	column affected_count
		dataType: int64
		formatString: #,0
		lineageTag: af71fcde-0b94-5332-8254-1b981ce86979
		summarizeBy: sum
		sourceColumn: affected_count

	column handling
		dataType: string
		lineageTag: 1da0dab9-f466-5f18-a734-56ceafb2bfb7
		summarizeBy: none
		sourceColumn: handling

	partition mart_data_quality = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\mart_data_quality.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"sort_order", Int64.Type}, {"issue", type text}, {"source_system", type text}, {"affected_count", Int64.Type}, {"handling", type text}}, "en-US")
				in
					Typed

