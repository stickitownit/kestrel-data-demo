	partition rpt_sales_overview = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\rpt_sales_overview.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"invoice_line_id", type text}, {"invoice_id", type text}, {"invoice_date", type date}, {"invoice_month", type date}, {"doc_type", type text}, {"is_return", type logical}, {"city", type text}, {"warehouse_id", type text}, {"customer_id", type text}, {"customer_name", type text}, {"customer_type", type text}, {"salesperson_id", type text}, {"salesperson_name", type text}, {"product_sku", type text}, {"product_name", type text}, {"category", type text}, {"brand", type text}, {"is_unknown_product", type logical}, {"quantity", Int64.Type}, {"gross_amount_pkr", Currency.Type}, {"discount_amount_pkr", Currency.Type}, {"net_amount_pkr", Currency.Type}, {"cost_amount_pkr", Currency.Type}, {"returns_amount_pkr", Currency.Type}}, "en-US")
				in
					Typed

