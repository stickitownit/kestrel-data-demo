		sourceColumn: is_slowing

	column slowdown_rank_in_city
		dataType: int64
		formatString: #,0
		lineageTag: 6861ceb1-2b3b-5f7f-be56-d948ce551433
		summarizeBy: none
		sourceColumn: slowdown_rank_in_city

	column lost_sales_per_month = IF(mart_product_city_trend[is_slowing], VAR sku = mart_product_city_trend[product_sku] VAR price = CALCULATE(DIVIDE(SUM(rpt_sales_overview[net_amount_pkr]), SUM(rpt_sales_overview[quantity])), REMOVEFILTERS(), rpt_sales_overview[product_sku] = sku, rpt_sales_overview[is_return] = FALSE()) VAR gap = mart_product_city_trend[daily_units_base] * mart_product_city_trend[rest_of_country_change] - mart_product_city_trend[daily_units_cur] RETURN MAX(0, gap) * 30 * price, 0)
		dataType: double
		formatString: \R\s #,0
		lineageTag: 7d547be9-a7dc-5b83-a6e8-a5371a62a1a5
		summarizeBy: sum

	column lost_lakh = mart_product_city_trend[lost_sales_per_month] / 100000
		dataType: double
		formatString: \R\s 0.0 \l\a\k\h
		lineageTag: b06064e9-c03e-597f-a9a1-edb9f4c8c76e
		summarizeBy: sum

	partition mart_product_city_trend = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\mart_product_city_trend.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"product_city_id", type text}, {"product_sku", type text}, {"product_name", type text}, {"category", type text}, {"city", type text}, {"as_of_date", type date}, {"cur_start", type date}, {"base_start", type date}, {"units_cur", type number}, {"units_base", type number}, {"daily_units_cur", type number}, {"daily_units_base", type number}, {"city_change", type number}, {"rest_of_country_change", type number}, {"seasonality_adjusted_index", type number}, {"is_slowing", type logical}, {"slowdown_rank_in_city", Int64.Type}}, "en-US")
				in
					Typed

