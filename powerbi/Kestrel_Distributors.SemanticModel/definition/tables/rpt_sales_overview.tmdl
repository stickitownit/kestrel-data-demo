table rpt_sales_overview
	lineageTag: b77b09b9-c115-5593-ab2e-e9e86f370d56

	measure 'Net Sales' = SUM(rpt_sales_overview[net_amount_pkr])
		formatString: \R\s\ #,0
		lineageTag: 81a61294-5a50-5297-b7f8-5f7bbef8a990

	measure Returns = -SUM(rpt_sales_overview[returns_amount_pkr])
		formatString: \R\s\ #,0
		lineageTag: 5a9239cf-38fb-5971-af1e-a2305a67e159

	measure 'Returns %' = DIVIDE([Returns], [Net Sales] + [Returns])
		formatString: 0.0%
		lineageTag: 14d879f2-2ec7-5545-91c7-4754ff295c5b

	measure 'Active Customers' = CALCULATE(DISTINCTCOUNT(rpt_sales_overview[customer_id]), rpt_sales_overview[is_return] = FALSE())
		formatString: #,0
		lineageTag: 34094e6d-1830-584a-9a66-51e74455875f

	measure 'Gross Margin %' = DIVIDE([Net Sales] - SUM(rpt_sales_overview[cost_amount_pkr]), [Net Sales])
		formatString: 0.0%
		lineageTag: 3ebc8178-607d-5df5-8403-a18f1522bb04

	measure 'Net Sales PM' = VAR maxd = CALCULATE(MAX(rpt_sales_overview[invoice_date]), REMOVEFILTERS()) VAR b = EOMONTH(maxd, -2) + 1 RETURN CALCULATE([Net Sales], REMOVEFILTERS(dim_date), dim_date[date_day] >= EDATE(b, -1), dim_date[date_day] <= EOMONTH(EDATE(b, -1), 0))
		formatString: #,0
		lineageTag: cf417d68-044a-5b0b-829a-b72fb6b29464

	measure 'MoM %' = DIVIDE([Net Sales Last Month] - [Net Sales PM], [Net Sales PM])
		formatString: ▲ +0.0%;▼ -0.0%;0.0%
		lineageTag: fde9581a-70e9-5e04-9a93-14d7974ffe16

	measure 'Net Sales LY' = VAR maxd = CALCULATE(MAX(rpt_sales_overview[invoice_date]), REMOVEFILTERS()) VAR b = EOMONTH(maxd, -2) + 1 RETURN CALCULATE([Net Sales], REMOVEFILTERS(dim_date), dim_date[date_day] >= EDATE(b, -12), dim_date[date_day] <= EOMONTH(EDATE(b, -12), 0))
		formatString: #,0
		lineageTag: e74130d7-4424-5eeb-a035-f4dacc92705f

	measure 'YoY %' = DIVIDE([Net Sales Last Month] - [Net Sales LY], [Net Sales LY])
		formatString: ▲ +0.0%;▼ -0.0%;0.0%
		lineageTag: 2537eb22-3d26-5c46-ad38-e3d6bfa24db9

	measure 'Data Label' = "Illustrative data — fictional company"
		lineageTag: cac7faef-5b57-564f-8819-ee322c7c69cd

	measure 'Net Sales Cr' = [Net Sales] / 10000000
		formatString: \R\s 0.0 \C\r
		lineageTag: 60db2908-9ab5-5c61-b393-8487f4448a02

	measure 'Last Full Month' = VAR maxd = CALCULATE(MAX(rpt_sales_overview[invoice_date]), REMOVEFILTERS()) VAR b = EOMONTH(maxd, -2) + 1 RETURN FORMAT(b, "mmmm yyyy")
		lineageTag: 6211f4e1-f593-53d5-92d0-bfea756e1d9e

	measure 'Sales at Stake Text' = VAR v = [Lost Sales per Month] + [Churned Sales per Month] + [Target Shortfall 3M] / 3 RETURN IF(ISBLANK(v), BLANK(), IF(ABS(v) >= 10000000, "Rs " & FORMAT(v / 10000000, "0.0") & " Cr", "Rs " & FORMAT(v / 100000, "0.0") & " lakh"))
		lineageTag: 58e0cfba-4483-54db-b8d6-5f1fe6a24b0e

	measure 'Net Sales Last Month' = VAR maxd = CALCULATE(MAX(rpt_sales_overview[invoice_date]), REMOVEFILTERS()) VAR b = EOMONTH(maxd, -2) + 1 RETURN CALCULATE([Net Sales], REMOVEFILTERS(dim_date), dim_date[date_day] >= EDATE(b, 0), dim_date[date_day] <= EOMONTH(EDATE(b, 0), 0))
		formatString: #,0
		lineageTag: 98e2d16a-86f0-5dad-a3c8-31428c589d84

	measure 'Net Sales Last Month Text' = VAR v = [Net Sales Last Month] RETURN IF(ISBLANK(v), BLANK(), IF(ABS(v) >= 10000000, "Rs " & FORMAT(v / 10000000, "0.0") & " Cr", "Rs " & FORMAT(v / 100000, "0.0") & " lakh"))
		lineageTag: 4d029c44-25f1-5043-8810-75c73e26d0cf

	measure 'Net Sales Text' = VAR v = [Net Sales] RETURN IF(ISBLANK(v), BLANK(), IF(ABS(v) >= 10000000, "Rs " & FORMAT(v / 10000000, "0.0") & " Cr", "Rs " & FORMAT(v / 100000, "0.0") & " lakh"))
		lineageTag: 02cc51a8-00c2-5b3d-99b6-cb81f301b722

	measure 'Active Customers LM' = VAR maxd = CALCULATE(MAX(rpt_sales_overview[invoice_date]), REMOVEFILTERS()) VAR b = EOMONTH(maxd, -2) + 1 RETURN CALCULATE(DISTINCTCOUNT(rpt_sales_overview[customer_id]), REMOVEFILTERS(dim_date), dim_date[date_day] >= b, dim_date[date_day] <= EOMONTH(b, 0), rpt_sales_overview[is_return] = FALSE())
		formatString: #,0
		lineageTag: d188b3cc-cf10-5dee-81e4-d9d5e2be2536

	measure 'Gross Margin LM' = VAR maxd = CALCULATE(MAX(rpt_sales_overview[invoice_date]), REMOVEFILTERS()) VAR b = EOMONTH(maxd, -2) + 1 RETURN CALCULATE([Gross Margin %], REMOVEFILTERS(dim_date), dim_date[date_day] >= b, dim_date[date_day] <= EOMONTH(b, 0))
		formatString: 0.0%
		lineageTag: e75f7c08-e158-55e0-b1ed-a4b1bcc4378e

